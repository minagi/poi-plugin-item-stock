{
    "name": "poi-plugin-item-stock",
    "version": "0.1.0",
    "description": "道具库存（消耗品一览）plugin for poi",
    "main": "index.js",
    "keywords": [
        "kancolle",
        "poi-plugin"
    ],
    "repository": "https://github.com/aabbcco/poi-plugin-item-stock.git",
    "author": {
        "name": "aabbcco",
        "email": "aabbcco@foxmail.com"
    },
    "contributors": [
        {
            "name": "Greesea",
            "url": "https://github.com/Greesea"
        }
    ],
    "license": "MIT",
    "files": [
        "index.js",
        "views/**/*.js",
        "redux/**/*.js",
        "assets",
        "i18n",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "prepack": "poi-util-transpile",
        "postpack": "npm run clean:js",
        "prepublishOnly": "npm run build",
        "test": "echo \"Warning: no test specified\"",
        "clean:js": "node scripts/clean-js.js",
        "build": "poi-util-transpile && node scripts/build.js && node scripts/clean-js.js",
        "build:transpile": "poi-util-transpile",
        "build:dist": "node scripts/build.js",
        "build:npm": "npm pack ./dist",
        "build:zip": "node scripts/create-zip.js",
        "build:all": "npm run build && npm run build:npm && npm run build:zip",
        "clean": "node scripts/clean-js.js --all"
    },
    "peerDependencies": {
        "lodash": "^4.0.0",
        "react": "^18.0.0",
        "react-fontawesome": "^1.7.0",
        "react-redux": "^9.0.0",
        "reselect": "^5.0.0",
        "styled-components": "^6.0.0"
    },
    "devDependencies": {
        "archiver": "^5.3.1",
        "fs-extra": "^10.1.0",
        "poi-util-transpile": "^8.2.2"
    },
    "poiPlugin": {
        "title": "meta.name",
        "description": "meta.description",
        "icon": "fa/cube"
    }
}
